generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./local.db"
}

model Application {
  id        String   @id @default(cuid())
  company   String
  role      String
  status    String   @default("applied") // applied, interviewing, offer, rejected, withdrawn
  source    String?  // job board, referral, etc.
  appliedAt DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id        String   @id @default(cuid())
  name      String   // e.g. "Resume v1", "Senior Dev 2024"
  content   String   // resume text or summary
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
